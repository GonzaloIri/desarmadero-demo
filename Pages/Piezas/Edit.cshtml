@page
@model proyecto_desarmado.Pages.Piezas.EditModel

@{
    ViewData["Title"] = "Editar pieza";
}

<h1>Editar pieza</h1>

<h4>Datos de la pieza</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="Pieza.Id" />
            <input type="hidden" asp-for="Pieza.Codigo" />
            <input type="hidden" asp-for="Pieza.Ubicacion" />

            <div class="mb-3">
                <label asp-for="Pieza.Nombre"
                       class="control-label"></label>
                <span class="text-danger">*</span>

                <input asp-for="Pieza.Nombre"
                       class="form-control"
                       aria-required="true" />

                <span asp-validation-for="Pieza.Nombre"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.Categoria"
                       class="control-label"></label>
                <span class="text-danger">*</span>

                <input asp-for="Pieza.Categoria"
                       class="form-control"
                       aria-required="true" />

                <span asp-validation-for="Pieza.Categoria"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.MarcaOrigen"
                       class="control-label"></label>
                <span class="text-danger">*</span>

                <input asp-for="Pieza.MarcaOrigen"
                       class="form-control"
                       aria-required="true" />

                <span asp-validation-for="Pieza.MarcaOrigen"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.ModeloOrigen"
                       class="control-label"></label>
                <span class="text-danger">*</span>

                <input asp-for="Pieza.ModeloOrigen"
                       class="form-control"
                       aria-required="true" />

                <span asp-validation-for="Pieza.ModeloOrigen"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.AnioOrigen"
                       class="control-label"></label>

                <input asp-for="Pieza.AnioOrigen"
                       class="form-control"
                       type="number"
                       min="1900"
                       max="2100" />

                <span asp-validation-for="Pieza.AnioOrigen"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.Color"
                       class="control-label"></label>

                <input asp-for="Pieza.Color"
                       class="form-control" />

                <span asp-validation-for="Pieza.Color"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.PatenteOrigen"
                       class="control-label"></label>

                <input asp-for="Pieza.PatenteOrigen"
                       class="form-control" />

                <span asp-validation-for="Pieza.PatenteOrigen"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.NumeroRudac"
                       class="control-label"></label>

                <input asp-for="Pieza.NumeroRudac"
                       class="form-control" />

                <span asp-validation-for="Pieza.NumeroRudac"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.NumeroPrecinto"
                       class="control-label"></label>

                <input asp-for="Pieza.NumeroPrecinto"
                       class="form-control" />

                <span asp-validation-for="Pieza.NumeroPrecinto"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.Compatibilidades"
                       class="control-label"></label>

                <input asp-for="Pieza.Compatibilidades"
                       class="form-control" />

                <span asp-validation-for="Pieza.Compatibilidades"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.Estado"
                       class="control-label"></label>

                <select asp-for="Pieza.Estado"
                        class="form-select">
                    <option value="Disponible">Disponible</option>
                    <option value="Reservada">Reservada</option>
                    <option value="Vendida">Vendida</option>
                    <option value="Descartada">Descartada</option>
                </select>

                <span asp-validation-for="Pieza.Estado"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.Precio"
                       class="control-label"></label>

                <input asp-for="Pieza.Precio"
                       class="form-control"
                       type="number"
                       step="0.01"
                       min="0"
                       asp-format="{0:0.00}" />

                <span asp-validation-for="Pieza.Precio"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.Observaciones"
                       class="control-label"></label>

                <textarea asp-for="Pieza.Observaciones"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Pieza.Observaciones"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Pieza.VehiculoId"
                       class="control-label"></label>

                <select asp-for="Pieza.VehiculoId"
                        class="form-select"
                        asp-items="ViewBag.VehiculoId">
                    <option value="">Sin relacionar con un vehículo</option>
                </select>

                <span asp-validation-for="Pieza.VehiculoId"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar
            </button>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Volver al listado</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}