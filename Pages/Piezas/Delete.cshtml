@page
@model proyecto_desarmado.Pages.Piezas.DeleteModel

@{
    ViewData["Title"] = "Eliminar pieza";
}

<h1>Eliminar pieza</h1>

<div class="alert alert-warning">
    <strong>¿Está seguro de que quiere eliminar esta pieza?</strong>
    Esta acción no se puede deshacer.
</div>

<div>
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Pieza.Nombre)
        </dt>
        <dd class="col-sm-9">
            @Model.Pieza.Nombre
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Pieza.Categoria)
        </dt>
        <dd class="col-sm-9">
            @Model.Pieza.Categoria
        </dd>

        <dt class="col-sm-3">
            Vehículo de origen
        </dt>
        <dd class="col-sm-9">
            @Model.Pieza.MarcaOrigen @Model.Pieza.ModeloOrigen
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Pieza.Color)
        </dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.Pieza.Color)
                ? "-"
                : Model.Pieza.Color)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Pieza.NumeroRudac)
        </dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.Pieza.NumeroRudac)
                ? "-"
                : Model.Pieza.NumeroRudac)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Pieza.NumeroPrecinto)
        </dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.Pieza.NumeroPrecinto)
                ? "-"
                : Model.Pieza.NumeroPrecinto)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Pieza.Estado)
        </dt>
        <dd class="col-sm-9">
            @Model.Pieza.Estado
        </dd>

        <dt class="col-sm-3">
            Vehículo registrado
        </dt>
        <dd class="col-sm-9">
            @if (Model.Pieza.Vehiculo != null)
            {
                @Model.Pieza.Vehiculo.Descripcion
            }
            else
            {
                <span>Sin relacionar</span>
            }
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Pieza.Id" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            Cancelar
        </a>
    </form>
</div>