@{
    var pagina = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Desarmadero</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <aside class="sidebar">
        <a class="brand" asp-page="/Index"><span class="brand-mark" aria-hidden="true">D<span> /</span></span><span>DESARMADERO<small>CONTROL DE INVENTARIO</small></span></a>
        <p class="nav-caption">ESPACIO DE TRABAJO</p>
        <nav aria-label="Navegación principal">
            <a class="side-link @(pagina == "/Index" ? "selected" : "")" asp-page="/Index"><span aria-hidden="true">01</span> Resumen</a>
            <a class="side-link @(pagina.StartsWith("/Vehiculos") ? "selected" : "")" asp-page="/Vehiculos/Index"><span aria-hidden="true">02</span> Vehículos</a>
            <a class="side-link @(pagina.StartsWith("/Piezas") ? "selected" : "")" asp-page="/Piezas/Index"><span aria-hidden="true">03</span> Piezas y stock</a>
        </nav>
        <div class="sidebar-note"><span class="tiny-bar"></span>Todo en su lugar.<small>Vehículos, piezas y seguimiento.</small></div>
    </aside>
    <div class="workspace">
        <header class="topbar"><span>GESTIÓN <span class="slash">/</span> @ViewData["Title"]</span><span class="workspace-label">DESARMADERO</span></header>
        <main id="contenido" tabindex="-1"><div class="alert alert-warning" role="status"><strong>DEMO · Solo consulta</strong><br />Vehículos e identificadores ficticios. Podés explorar y buscar; guardar, eliminar e importar están deshabilitados.</div>@RenderBody()</main>
        <footer>Desarmadero <span>Inventario y gestión</span><a asp-page="/Privacy">Privacidad</a></footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
